{
  "name": "apartments",
  "version": "1.0.0",
  "private": true,
  "description": "A full-fledged apartment management system like Airbnb built using Hono + Astro + Drizzle for Cloudflare",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @apartments/db generate",
    "db:migrate": "pnpm --filter @apartments/db migrate"
  },
  "keywords": [
    "apartments",
    "airbnb",
    "hono",
    "astro",
    "drizzle",
    "cloudflare"
  ],
  "author": "",
  "license": "ISC"
}
