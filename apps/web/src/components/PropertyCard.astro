---
export interface Props {
  id: string;
  title: string;
  city: string;
  country: string;
  pricePerNight: number;
  rating?: number;
  reviewCount?: number;
  bedrooms: number;
  imageUrl?: string;
  propertyType: string;
}

const {
  id,
  title,
  city,
  country,
  pricePerNight,
  rating = 0,
  reviewCount = 0,
  bedrooms,
  imageUrl = 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800',
  propertyType,
} = Astro.props;
---

<a href={`/property/${id}`} class="group block">
  <div class="relative aspect-square rounded-xl overflow-hidden bg-gray-200">
    <img
      src={imageUrl}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
      loading="lazy"
    />
    <button
      class="absolute top-3 right-3 p-2 rounded-full bg-white/80 hover:bg-white transition"
      aria-label="Add to wishlist"
    >
      <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
      </svg>
    </button>
  </div>
  
  <div class="mt-3">
    <div class="flex items-center justify-between">
      <h3 class="font-semibold text-gray-900 truncate">{city}, {country}</h3>
      {rating > 0 && (
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4 text-gray-900" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
          <span class="text-sm text-gray-900">{rating.toFixed(1)}</span>
        </div>
      )}
    </div>
    <p class="text-sm text-gray-500 mt-1">{propertyType} · {bedrooms} {bedrooms === 1 ? 'bedroom' : 'bedrooms'}</p>
    <p class="text-sm text-gray-500">{title}</p>
    <p class="mt-2">
      <span class="font-semibold text-gray-900">${pricePerNight}</span>
      <span class="text-gray-500"> night</span>
    </p>
  </div>
</a>
