---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Become a Host | Apartments">
  <Header />
  
  <!-- Hero Section -->
  <section class="relative bg-gray-900 text-white">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1600"
        alt="Beautiful home"
        class="w-full h-full object-cover opacity-40"
      />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-40">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          Open your door to hosting
        </h1>
        <p class="text-xl text-gray-200 mb-8">
          Share your space and earn extra income while meeting travelers from around the world.
        </p>
        <a
          href="/host/listing"
          class="inline-block bg-white text-gray-900 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition"
        >
          Get Started
        </a>
      </div>
    </div>
  </section>
  
  <!-- Earnings Calculator -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            See how much you could earn
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            Estimate your potential earnings based on your location and property type.
          </p>
          
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Your location</label>
              <input
                type="text"
                placeholder="Enter your city"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Property type</label>
              <select class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option>Entire place</option>
                <option>Private room</option>
                <option>Shared room</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Bedrooms</label>
              <select class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option>1 bedroom</option>
                <option>2 bedrooms</option>
                <option>3 bedrooms</option>
                <option>4+ bedrooms</option>
              </select>
            </div>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl p-8 text-white text-center">
          <p class="text-lg mb-2">You could earn</p>
          <p class="text-6xl font-bold mb-2">$1,200</p>
          <p class="text-lg opacity-90">per month</p>
          <p class="text-sm opacity-75 mt-4">
            Based on average earnings for similar listings in your area
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- How It Works -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-16">
        Hosting in 3 simple steps
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-20 h-20 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl font-bold text-primary-600">1</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Create your listing</h3>
          <p class="text-gray-600">
            Share details about your space, upload photos, and set your availability and pricing.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-20 h-20 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl font-bold text-primary-600">2</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Welcome guests</h3>
          <p class="text-gray-600">
            Respond to booking requests, communicate with guests, and provide a great experience.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-20 h-20 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl font-bold text-primary-600">3</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Get paid</h3>
          <p class="text-gray-600">
            Receive secure payments directly to your bank account after each completed stay.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Features -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-16">
        Why host with us?
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="p-6 border border-gray-200 rounded-xl">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Competitive payouts</h3>
          <p class="text-gray-600 text-sm">
            Keep more of what you earn with our competitive commission structure.
          </p>
        </div>
        
        <div class="p-6 border border-gray-200 rounded-xl">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Host protection</h3>
          <p class="text-gray-600 text-sm">
            $1M damage protection and liability insurance included with every booking.
          </p>
        </div>
        
        <div class="p-6 border border-gray-200 rounded-xl">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">24/7 support</h3>
          <p class="text-gray-600 text-sm">
            Our support team is available around the clock to help you with any issues.
          </p>
        </div>
        
        <div class="p-6 border border-gray-200 rounded-xl">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Smart pricing</h3>
          <p class="text-gray-600 text-sm">
            Our tools help you set competitive prices and maximize your earnings.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Testimonials -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-16">
        Hear from our hosts
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <div class="flex items-center gap-4 mb-4">
            <img
              src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100"
              alt="Sarah"
              class="w-12 h-12 rounded-full object-cover"
            />
            <div>
              <p class="font-semibold text-gray-900">Sarah M.</p>
              <p class="text-sm text-gray-500">Host since 2022</p>
            </div>
          </div>
          <p class="text-gray-600">
            "Hosting has been an incredible experience. I've met amazing people from around the world and earned extra income to support my travels."
          </p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <div class="flex items-center gap-4 mb-4">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100"
              alt="Michael"
              class="w-12 h-12 rounded-full object-cover"
            />
            <div>
              <p class="font-semibold text-gray-900">Michael R.</p>
              <p class="text-sm text-gray-500">Host since 2021</p>
            </div>
          </div>
          <p class="text-gray-600">
            "The platform makes everything so easy. From listing my property to managing bookings, it's all streamlined and simple."
          </p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <div class="flex items-center gap-4 mb-4">
            <img
              src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100"
              alt="Emily"
              class="w-12 h-12 rounded-full object-cover"
            />
            <div>
              <p class="font-semibold text-gray-900">Emily T.</p>
              <p class="text-sm text-gray-500">Host since 2023</p>
            </div>
          </div>
          <p class="text-gray-600">
            "I was nervous at first, but the support team made me feel confident. Now I'm earning great income from my spare room!"
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="py-16 md:py-24 bg-primary-500 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to start hosting?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Join thousands of hosts and start earning today. It only takes a few minutes to get started.
      </p>
      <a
        href="/host/listing"
        class="inline-block bg-white text-primary-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-100 transition"
      >
        Create Your Listing
      </a>
    </div>
  </section>
  
  <Footer />
</BaseLayout>
